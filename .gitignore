# ==============================================================================
# KRX ETF Radar - .gitignore
# ==============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments (uv / venv)
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# UV Cache
.uv/

# Testing & Type Checking
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.pytype/
.ruff_cache/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# IDEs & Code Editors
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System Files
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Logs and Temporary Files
*.log
*.tmp
*.bak
*.swp

# Note on Data Files:
# data/etf_data.json and data/etf_data.js are intentionally TRACKED in git
# so that GitHub Pages and offline browser deployments have the complete 1,171 ETF snapshot.
